# API listen address
ANTREQUEUE_ADDR=:8090

# Bearer secret your services present when submitting jobs
ANTREQUEUE_SERVICE_SECRET=change-me-submit-secret

# HMAC secret used to sign outbound webhook callbacks, so your app can verify
# a completion actually came from antrequeue
ANTREQUEUE_WEBHOOK_SECRET=change-me-webhook-signing-secret

# Postgres for durable job records (v1)
ANTREQUEUE_DATABASE_URL=postgres://antrequeue:antrequeue@localhost:5432/antrequeue?sslmode=disable

# Redis for distributed locks and rate limiting
ANTREQUEUE_REDIS_URL=redis://localhost:6379/0

# RabbitMQ carries the work queue: per-message ack, retry and DLQ (v1)
ANTREQUEUE_AMQP_URL=amqp://guest:guest@localhost:5672/

# Max jobs dispatched per second (backpressure valve)
ANTREQUEUE_DISPATCH_RATE=50
